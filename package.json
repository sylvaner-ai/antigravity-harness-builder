{
  "name": "antigravity-harness-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Générateur déterministe et explicable de harnais de développement pour Google Antigravity",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "fixtures:selection": "tsx scripts/build-selection-fixtures.mts"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "isomorphic-dompurify": "^2.21.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.64.0",
    "mammoth": "^1.9.0",
    "next": "^15.2.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
