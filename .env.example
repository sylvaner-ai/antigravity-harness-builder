# ==============================================================================
# Antigravity Harness Builder — Configuration d'environnement (.env.example)
# Aucun secret réel ne doit jamais figurer dans ce fichier ni dans l'image Docker
# ==============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000

# Base de données PostgreSQL (Jalon 2+)
DATABASE_URL=postgresql://ahb_user:change_me_in_env@localhost:5433/ahb_db

# Stockage privé des documents et exports (Jalon 3+)
PRIVATE_STORAGE_DIR=/data/storage
MAX_FILE_SIZE_MB=20
MAX_PROJECT_FILES=15

# Authentification et Compte Administrateur Initial (Jalon 5)
SESSION_SECRET=replace_with_at_least_32_bytes_random_hex_secret
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_immediately
ALLOW_REGISTRATION=false

# Fournisseur LLM — Google Gemini (Jalon 3+)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
MAX_LLM_CALLS_PER_GENERATION=12
MAX_LLM_TOKENS_PER_GENERATION=250000

# Synchronisation Catalogue ECC (Jalon 2+)
ECC_REPO_OWNER=affaan-m
ECC_REPO_NAME=ECC
ECC_DEFAULT_REF=main
GITHUB_TOKEN=
